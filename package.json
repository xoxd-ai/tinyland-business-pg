{
  "name": "@tummycrypt/tinyland-business-pg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "license": "MIT",
  "description": "PostgreSQL business content and booking schemas for Tinyland apps",
  "homepage": "https://github.com/xoxd-ai/tinyland-business-pg",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-business-pg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-business-pg.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content-schema": {
      "types": "./dist/content-schema.d.ts",
      "import": "./dist/content-schema.js"
    },
    "./booking-schema": {
      "types": "./dist/booking-schema.d.ts",
      "import": "./dist/booking-schema.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.js.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "check:package": "publint"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.39.3 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-orm": "^0.45.4",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
